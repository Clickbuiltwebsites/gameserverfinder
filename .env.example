# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# With NONE of these set, `npm run dev` still works: the app runs in demo mode
# with in-memory listings and a "continue as demo user" button. Demo mode is
# disabled whenever NODE_ENV=production, so it cannot reach a deployment.
# ---------------------------------------------------------------------------

# --- Database (Neon, Vercel Postgres, Supabase — anything Postgres) ---------
# Vercel Postgres / Neon give you this string in the dashboard.
DATABASE_URL="[FILL: POSTGRES_CONNECTION_STRING]"

# --- Auth.js core ----------------------------------------------------------
# Generate with:  npx auth secret      (or: openssl rand -base64 32)
AUTH_SECRET="[FILL: AUTH_SECRET]"
# Only needed if the deployment URL cannot be inferred. Vercel sets this itself.
# AUTH_URL="https://gameserverfinder.com"

# --- Sign in with Google (the "Gmail" option) ------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
#                          http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="[FILL: GOOGLE_CLIENT_ID]"
AUTH_GOOGLE_SECRET="[FILL: GOOGLE_CLIENT_SECRET]"

# --- Sign in with an email magic link --------------------------------------
# Any SMTP provider (Resend, Postmark, SendGrid, Fastmail…).
# Requires DATABASE_URL as well — the one-time tokens are stored in Postgres.
EMAIL_SERVER="smtp://[FILL: SMTP_USER]:[FILL: SMTP_PASSWORD]@[FILL: SMTP_HOST]:587"
EMAIL_FROM="GameServerFinder <no-reply@gameserverfinder.com>"

# --- Image uploads (Vercel Blob) -------------------------------------------
# Vercel dashboard → Storage → Blob → connect to project. Vercel injects this
# automatically once connected; set it manually only for local uploads.
BLOB_READ_WRITE_TOKEN="[FILL: BLOB_READ_WRITE_TOKEN]"

# --- Canonical URL ---------------------------------------------------------
# Only needed if you are not on Vercel; otherwise it is inferred per deployment.
# NEXT_PUBLIC_SITE_URL="https://gameserverfinder.com"
